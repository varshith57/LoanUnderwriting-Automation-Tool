{
  "id": "harbor.v1",
  "bank": "Harbor Bank",
  "detect": ["HARBOR BANK", "Statement of Account"],
  "summary": {
    "account_name": {"pattern": "Account Name:\\s*(.+)", "type": "text"},
    "account_number": {"pattern": "Account Number:\\s*(\\d+)", "type": "text"},
    "period": {"pattern": "Period:\\s*(.+)", "type": "text"},
    "opening": {"pattern": "Opening Balance:\\s*(-?[\\d,]+\\.\\d{2})", "type": "money"},
    "total_credits": {"pattern": "Total Credits:\\s*([\\d,]+\\.\\d{2})", "type": "money"},
    "total_debits": {"pattern": "Total Debits:\\s*([\\d,]+\\.\\d{2})", "type": "money"},
    "closing": {"pattern": "Closing Balance:\\s*(-?[\\d,]+\\.\\d{2})", "type": "money"}
  },
  "table": {
    "header_marker": "Trans Date",
    "footer_pattern": "^Page \\d+ of \\d+$",
    "columns": {
      "date": [0.0, 0.18],
      "narration": [0.18, 0.54],
      "debit": [0.54, 0.67],
      "credit": [0.67, 0.81],
      "balance": [0.81, 1.0]
    },
    "date_pattern": "^\\d{2}-[A-Za-z]{3}-\\d{4}$",
    "date_format": "%d-%b-%Y",
    "amounts": "debit_credit",
    "narration_wraps": true
  }
}
